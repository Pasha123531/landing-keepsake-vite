mixin work-card(work)
  article.works-card(class=work.category)
    - const imageName = work.image ? work.image.replace(/\.png$/, '') : 'profile';
    +picture(
      imageName,
      work.title,
      400,
      315,
      '',
      '(min-width: 1280px) 357px, 100vw',
    )

    .works-overlay(tabindex='0')
      .overlay-icon +
      h3.overlay-title= work.title
      .overlay-line
      span.overlay-category= work.category
