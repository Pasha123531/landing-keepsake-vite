mixin work-card(work)
  article.work-card(class=`work-card--${work.category}`)
    - let imageName;
    if work.image
      - imageName = work.image.replace(/\.png$/, '');
    else
      - imageName = 'profile';
    +picture(
      imageName,
      work.title,
      400,
      315,
      '',
      '(min-width: 1280px) 357px, 100vw',
    )

    .work-card__overlay(tabindex='0')
      .work-card__icon +
      h3.work-card__title= work.title
      .work-card__line
      span.work-card__category= work.category
