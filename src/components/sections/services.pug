//- Послуги
section#about.services
  .container
    .services__header
      h2.section-title What do we do
      p.services__intro We are a small team of designers and makers who help brands look their best online and offline.

    .services__grid
      each service in services
        article.service-card
          .service-card__icon
            img(
              src=`./icons/${service.icon}`,
              alt='',
              width='96',
              height='96',
              loading='lazy'
            )
          h3.service-card__title= service.title
          p.service-card__desc= service.description
