//- Послуги
section#about.services
  .container
    .services-header
      h2.section-title What do we do
      p.services-intro We are a small team of designers and makers who help brands look their best online and offline.

    .services-grid
      each service in services
        article.service-card
          .service-icon
            img(
              src=`/icons/${service.icon}`
              alt=""
              width="96"
              height="96"
              loading="lazy"
            )
          h3.service-title= service.title
          p.service-desc= service.description