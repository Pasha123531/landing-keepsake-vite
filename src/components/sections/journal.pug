//- Журнал
section#journal.journal
  .container
    .journal__header
      h2.section-title From the journal
      p.journal__intro Notes on process, case studies and things that inspire us.

    .journal__grid
      each post in journal
        article.journal-card
          .journal-card__thumb
            +picture(
              post.image.replace(/\.png$/, ''),
              post.title,
              400,
              400,
              '',
              '150px',
            )

          .journal-card__content
            .journal-card__meta #{ post.date } / #{ post.category }
            h3.journal-card__title= post.title
            p.journal-card__text Maecenas faucibus mollis interdum. Cum sociis natoque penatibus et magnis dis parturient montes.
            a.journal-card__link(href='#journal') Read more >
