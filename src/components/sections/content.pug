//- Портфоліо
section#works.works
  .container
    each category, i in categories
      input.filter-radio(
        type="radio"
        name="work-filter"
        id=`f-${category.id}`
        checked=i === 0
        aria-label=category.label
      )

    .works-header
      h2.section-title Our awesome works

      .works-filters
        each category in categories
          label.filter-chip(for=`f-${category.id}`)= category.label

    .works-grid
      each work in works
        article.works-card(class=work.category)
          if work.image
            img(
              src=`/images/${work.image}`
              alt=work.title
              loading="lazy"
            )
          else
            img(
              src="https://placehold.co/400x315/222428/222428"
              alt=work.title
              loading="lazy"
            )

          .works-overlay(tabindex="0")
            .overlay-icon +
            h3.overlay-title= work.title
            .overlay-line
            span.overlay-category= work.category

    .works-action
      a.btn.btn-secondary.btn-load-more(href="#works") Load more works

//- Заклик до співпраці
section.cta
  .container.cta-inner
    h2.cta-title Would you love to work with us?
    a.btn.btn-primary.btn-cta(href="#contact") Contact us

//- Послуги
section#about.services
  .container
    .services-header
      h2.section-title What do we do
      p.services-intro We are a small team of designers and makers who help brands look their best online and offline.

    .services-grid
      each service in services
        article.service-card
          .service-icon
            img(
              src=`/icons/${service.icon}`
              alt=""
              width="96"
              height="96"
              loading="lazy"
            )
          h3.service-title= service.title
          p.service-desc= service.description

//- Статистика
section.stats(aria-label="Our achievements")
  .container
    .stats-inner
      each stat in stats
        .stats-item
          span.stats-number= stat.number
          span.stats-label= stat.label

//- Клієнти та відгук
section.clients
  .container
    .clients-header
      h2.section-title Clients & kind words
      p.clients-intro Some of the teams that trusted us with their brands.

    .clients-logos
      each client in clients
        span.client-logo(class=client.className)= client.name

    .testimonial-card
      .testimonial-quote-icon(aria-hidden="true") “
      blockquote.testimonial-text Keepsake turned a vague brief into a brand we are proud of. The team was fast, honest about trade-offs and obsessed with the details.

      .testimonial-footer
        .testimonial-author
          img.author-avatar(
            src="/icons/Avatar.png"
            alt="Olena Marchenko"
            width="44"
            height="44"
            loading="lazy"
          )
          .author-details
            span.author-name Olena Marchenko
            span.author-role Marketing Lead, Nordly

        .testimonial-dots(aria-hidden="true")
          span.dot.active
          span.dot
          span.dot

//- Журнал
section#journal.journal
  .container
    .journal-header
      h2.section-title From the journal
      p.journal-intro Notes on process, case studies and things that inspire us.

    .journal-grid
      each post in journal
        article.journal-card
          .journal-thumb
            img(
              src=`/images/${post.image}`
              alt=post.title
              loading="lazy"
            )

          .journal-content
            .journal-meta #{post.date} / #{post.category}
            h3.journal-card-title= post.title
            p.journal-card-text Maecenas faucibus mollis interdum. Cum sociis natoque penatibus et magnis dis parturient montes.
            a.journal-link(href="#journal") Read more >