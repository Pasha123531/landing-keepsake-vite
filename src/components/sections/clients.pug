//- Клієнти та відгук
section.clients
  .container
    .clients__header
      h2.section-title Clients &amp; kind words
      p.clients__intro Some of the teams that trusted us with their brands.

    .clients__logos
      each client in clients
        span.client-logo(class=client.className)= client.name

    .testimonial
      .testimonial__quote-icon(aria-hidden='true') “
      blockquote.testimonial__text Keepsake turned a vague brief into a brand we are proud of. The team was fast, honest about trade-offs and obsessed with the details.

      .testimonial__footer
        .testimonial__author.author
          +picture(
            'avatar',
            'Olena Marchenko',
            400,
            400,
            'author__avatar',
            '44px',
          )
          .author__details
            span.author__name Olena Marchenko
            span.author__role Marketing Lead, Nordly

        .testimonial__dots(aria-hidden='true')
          span.testimonial__dot.testimonial__dot--active
          span.testimonial__dot
          span.testimonial__dot
