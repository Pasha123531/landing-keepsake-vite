//- Портфоліо
section#works.works
  .container.filter
    each category, i in categories
      input.filter__radio(
        type='radio',
        name='work-filter',
        id=`f-${category.id}`,
        checked=i === 0
      )

    .works__header
      h2.section-title Our awesome works

      .works__filters
        each category in categories
          label.filter__chip(for=`f-${category.id}`)= category.label

    .works__grid
      each work in works
        +work-card(work)

    .works__action
      a.btn.btn--secondary.btn--load-more(href='#works') Load more works
