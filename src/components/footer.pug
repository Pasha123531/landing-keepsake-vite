footer#contact.footer
  .container
    .footer__top
      each column in footerColumns
        .footer__col
          h2.footer__title= column.title
          ul.footer__links
            each link in column.links
              li
                a(href='#')= link

      .footer__col.footer__col--newsletter.newsletter
        h2.footer__title Newsletter
        p.newsletter__desc Fresh case studies and design notes, once a month.

        form.newsletter__form(action='#', method='post')
          .newsletter__input-group
            input(
              type='email',
              placeholder='Your email address',
              required,
              aria-label='Your email address'
            )
            button.btn.btn--primary.btn--subscribe(type='submit') Subscribe

          label.newsletter__consent
            input(type='checkbox', required)
            span I agree to the privacy policy

    .footer__divider

    .footer__bottom
      p.footer__copyright © 2026 Keepsake. All rights reserved.

      .footer__socials
        each social in socials
          a(href='#', aria-label=social.label)
            img(src=`./icons/${social.icon}`, alt='', width='28', height='28')
