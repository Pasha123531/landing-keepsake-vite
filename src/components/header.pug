header.header
  .container.header__inner
    a.logo(href='#', aria-label='Keepsake home')
      svg.logo__circle(
        viewBox='0 0 34 34',
        width='34',
        height='34',
        aria-hidden='true'
      )
        text(
          x='17',
          y='25',
          text-anchor='middle',
          fill='currentColor',
          font-size='25'
        ) K
      | eepsake

    input#menu-toggle.header__menu-toggle(
      type='checkbox',
      aria-label='Toggle navigation menu',
      aria-controls='main-navigation'
    )

    label.burger-menu(for='menu-toggle')
      span.burger-menu__line
      span.burger-menu__line
      span.burger-menu__line

    nav#main-navigation.nav(aria-label='Main navigation')
      ul.nav__list
        each item in navigation
          li
            a.nav__link(
              href=item.href,
              class={ 'nav__link--active': item.active },
              aria-current=item.active ? 'page' : false
            )= item.label

      button.favorite-btn(type='button', aria-label='Favourites')
        +icon('heart')
